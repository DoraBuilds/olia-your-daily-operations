# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — .env.local contains real keys and must NEVER be committed
# .env.example (no secrets) is safe to commit and documents required variables
.env.local
.env.docker
.env.prod
.env.*.local

# Claude Code internal workspace — never commit
.claude/

# Coverage reports — generated artifact, not source
coverage/
test-results/
playwright-report/

# Local Supabase CLI state
supabase/.temp/
supabase/.branches/

# Maestro E2E screenshot artifacts — written to the repo root by `takeScreenshot`
# steps in .maestro/flows/*.yaml, not meant to be committed (see #693)
/0[0-9]-*.png

# graphify knowledge-graph output — local tool artifact, not source
graphify-out/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
